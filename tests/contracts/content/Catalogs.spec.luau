--!strict

-- Playable catalogs: abilities, items, quests, zones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local AbilityCatalog = require(ReplicatedStorage.Definitions.Abilities.AbilityCatalog)
local ArchetypeCatalog = require(ReplicatedStorage.Definitions.Characters.ArchetypeCatalog)
local ArchetypeTalentCatalog = require(ReplicatedStorage.Definitions.Characters.ArchetypeTalentCatalog)
local BossCatalog = require(ReplicatedStorage.Definitions.Encounters.BossCatalog)
local DungeonCatalog = require(ReplicatedStorage.Definitions.Encounters.DungeonCatalog)
local HarnessApi = require(script.Parent.Parent.Parent.HarnessApi)
local IconCatalog = require(ReplicatedStorage.Definitions.Art.IconCatalog)
local ItemCatalog = require(ReplicatedStorage.Definitions.Items.ItemCatalog)
local LootTableCatalog = require(ReplicatedStorage.Definitions.Items.LootTableCatalog)
local MacroCatalog = require(ReplicatedStorage.Definitions.Combat.Macros.MacroCatalog)
local QuestCatalog = require(ReplicatedStorage.Definitions.World.QuestCatalog)
local RewardResolver = require(ServerScriptService.Domains.Progression.RewardResolver)
local SetBonusCatalog = require(ReplicatedStorage.Definitions.Items.SetBonusCatalog)
local TalentTreeCatalog = require(ReplicatedStorage.Definitions.Characters.TalentTreeCatalog)
local TransformationCatalog = require(ReplicatedStorage.Definitions.Characters.TransformationCatalog)
local ZoneCatalog = require(ReplicatedStorage.Definitions.World.ZoneCatalog)

type Harness = HarnessApi.Harness

local CatalogsSpec = {}

function CatalogsSpec.run(Harness: Harness)
	Harness.assert(AbilityCatalog.get("Pulse") ~= nil, "pulse ability exists")
	Harness.assert(AbilityCatalog.get("ComboStrike") ~= nil, "combo strike exists")
	Harness.assert(AbilityCatalog.get("MassMend") ~= nil, "mass mend exists")
	Harness.assert(AbilityCatalog.get("AstralStorm") ~= nil, "astral storm exists")
	Harness.assert(AbilityCatalog.count() >= 105, "ability catalog playable size")
	Harness.assert(AbilityCatalog.get("AstralStep") ~= nil, "astral step racial")
	Harness.assert(AbilityCatalog.get("SkyDash") ~= nil, "sky dash racial")
	Harness.assert(ItemCatalog.get("WardenBlade") ~= nil, "item catalog")
	Harness.assert(ItemCatalog.get("SentinelBow") ~= nil, "sentinel bow")
	Harness.assert(ItemCatalog.get("HealthTonic") ~= nil, "health tonic")
	Harness.assert(ItemCatalog.get("EnergyTonic") ~= nil, "energy tonic")
	Harness.assert(ItemCatalog.get("GuardianHelm") ~= nil, "guardian helm set piece")
	Harness.assert(ItemCatalog.get("SpireGreaves") ~= nil, "spire greaves set piece")
	Harness.assert(ItemCatalog.get("EmberHelm") ~= nil, "ember helm set piece")
	Harness.assert(ItemCatalog.get("PaleCirclet") ~= nil, "pale circlet set piece")
	Harness.assert(SetBonusCatalog.get("Guardian") ~= nil, "guardian set bonus")
	Harness.assert(SetBonusCatalog.get("Spire") ~= nil, "spire set bonus")
	Harness.assert(SetBonusCatalog.get("Ember") ~= nil, "ember set bonus")
	Harness.assert(SetBonusCatalog.get("Pale") ~= nil, "pale set bonus")
	Harness.assert(AbilityCatalog.get("HollowStrike") ~= nil, "hollow strike exists")
	Harness.assert(AbilityCatalog.get("WeaverForm") ~= nil, "weaver form exists")
	Harness.assert(AbilityCatalog.get("StalkerForm") ~= nil, "stalker form exists")
	Harness.assert(AbilityCatalog.get("LatticeBolt") ~= nil, "lattice bolt exists")
	Harness.assert(ItemCatalog.get("VoidHelm") ~= nil, "void helm")
	Harness.assert(ItemCatalog.get("RiftEdge") ~= nil, "rift edge")
	Harness.assert(SetBonusCatalog.get("Hollow") ~= nil, "hollow set bonus")
	Harness.assert(BossCatalog.get("Boss_Threshold_Guardian") ~= nil, "boss catalog")
	Harness.assert(TransformationCatalog.get("Overdrive") ~= nil, "overdrive form")
	Harness.assert(TransformationCatalog.get("WeaverForm") ~= nil, "weaver transformation")
	Harness.assert(TransformationCatalog.get("StalkerForm") ~= nil, "stalker transformation")
	Harness.assert(TransformationCatalog.get("LuminaryForm") ~= nil, "luminary transformation")
	Harness.assert(TransformationCatalog.get("SentinelFocus") ~= nil, "sentinel transformation")
	Harness.assert(TransformationCatalog.get("HexForm") ~= nil, "hexwright transformation")
	Harness.assert(TransformationCatalog.get("VanguardRage") ~= nil, "vanguard transformation")
	Harness.assert(TransformationCatalog.get("TempestForm") ~= nil, "tempest transformation")
	Harness.assert(TransformationCatalog.get("TemplarAegis") ~= nil, "templar transformation")
	Harness.assert(TransformationCatalog.get("ArbiterVision") ~= nil, "arbiter transformation")
	Harness.assert(TransformationCatalog.get("DragoonForm") ~= nil, "dragoon transformation")
	Harness.assert(TransformationCatalog.get("ChannelerFocus") ~= nil, "channeler transformation")
	Harness.assert(AbilityCatalog.get("Sanctuary") ~= nil, "sanctuary exists")
	Harness.assert(AbilityCatalog.get("RenewingLight") ~= nil, "renewing light exists")
	Harness.assert(AbilityCatalog.get("Volley") ~= nil, "volley exists")
	Harness.assert(AbilityCatalog.get("PinningShot") ~= nil, "pinning shot exists")
	Harness.assert(AbilityCatalog.get("SoulRot") ~= nil, "soul rot exists")
	Harness.assert(AbilityCatalog.get("CurseOfWeakness") ~= nil, "curse of weakness exists")
	Harness.assert(AbilityCatalog.get("LuminaryForm") ~= nil, "luminary form ability")
	Harness.assert(AbilityCatalog.get("SentinelFocus") ~= nil, "sentinel focus ability")
	Harness.assert(AbilityCatalog.get("HexForm") ~= nil, "hex form ability")
	Harness.assert(AbilityCatalog.get("VanguardRage") ~= nil, "vanguard rage ability")
	Harness.assert(AbilityCatalog.get("Shockwave") ~= nil, "shockwave exists")
	Harness.assert(AbilityCatalog.get("IronWill") ~= nil, "iron will exists")
	Harness.assert(AbilityCatalog.get("TempestForm") ~= nil, "tempest form ability")
	Harness.assert(AbilityCatalog.get("LightningRod") ~= nil, "lightning rod exists")
	Harness.assert(AbilityCatalog.get("Hailstorm") ~= nil, "hailstorm exists")
	Harness.assert(AbilityCatalog.get("TemplarAegis") ~= nil, "templar aegis ability")
	Harness.assert(AbilityCatalog.get("Judgment") ~= nil, "judgment exists")
	Harness.assert(AbilityCatalog.get("Consecrate") ~= nil, "consecrate exists")
	Harness.assert(AbilityCatalog.get("ArbiterVision") ~= nil, "arbiter vision ability")
	Harness.assert(AbilityCatalog.get("Inspire") ~= nil, "inspire exists")
	Harness.assert(AbilityCatalog.get("TimeWarp") ~= nil, "time warp exists")
	Harness.assert(AbilityCatalog.get("DragoonForm") ~= nil, "dragoon form ability")
	Harness.assert(AbilityCatalog.get("Skydrive") ~= nil, "skydrive exists")
	Harness.assert(AbilityCatalog.get("Impale") ~= nil, "impale exists")
	Harness.assert(AbilityCatalog.get("ChannelerFocus") ~= nil, "channeler focus ability")
	Harness.assert(AbilityCatalog.get("VoidChannel") ~= nil, "void channel exists")
	Harness.assert(AbilityCatalog.get("ArcOverload") ~= nil, "arc overload exists")
	Harness.assert(ArchetypeCatalog.get("Luminary") ~= nil, "luminary archetype")
	Harness.assert(ArchetypeCatalog.get("Sentinel") ~= nil, "sentinel archetype")
	Harness.assert(ArchetypeCatalog.get("Hexwright") ~= nil, "hexwright archetype")
	Harness.assert(ArchetypeCatalog.get("Vanguard") ~= nil, "vanguard archetype")
	Harness.assert(ArchetypeCatalog.get("Tempest") ~= nil, "tempest archetype")
	Harness.assert(ArchetypeCatalog.get("Templar") ~= nil, "templar archetype")
	Harness.assert(ArchetypeCatalog.get("Arbiter") ~= nil, "arbiter archetype")
	Harness.assert(ArchetypeCatalog.get("Dragoon") ~= nil, "dragoon archetype")
	Harness.assert(ArchetypeCatalog.get("Channeler") ~= nil, "channeler archetype")
	Harness.assert(LootTableCatalog.get("LootTable_StandardMob") ~= nil, "standard mob loot table")
	Harness.assert(LootTableCatalog.get("LootTable_WorldBoss") ~= nil, "world boss loot")
	Harness.assert(LootTableCatalog.get("LootTable_Dungeon_Void") ~= nil, "void dungeon loot")
	Harness.assert(LootTableCatalog.get("LootTable_Void_Pack") ~= nil, "void pack loot")
	Harness.assert(QuestCatalog.get("Quest_Threshold_ProvePulse") ~= nil, "slice quest")
	Harness.assert(QuestCatalog.get("Quest_Gate_AstralPost") ~= nil, "mail quest")
	Harness.assert(QuestCatalog.get("Quest_Threshold_SpireMandate") ~= nil, "raid mandate quest")
	Harness.assert(QuestCatalog.get("Quest_Void_RiftHollow") ~= nil, "rift hollow quest")
	Harness.assert(QuestCatalog.count() >= 41, "quest catalog size")
	Harness.assert(QuestCatalog.get("Quest_Origin_Threshold") ~= nil, "origin intro quest")
	Harness.assert(QuestCatalog.get("Quest_Arch_Warden") ~= nil, "archetype intro quest")
	Harness.assert(DungeonCatalog.get("Dungeon_Threshold_NodeUndercroft") ~= nil, "slice dungeon")
	Harness.assert(DungeonCatalog.get("Dungeon_Void_RiftHollow") ~= nil, "rift hollow dungeon")
	Harness.assert(DungeonCatalog.count() >= 7, "dungeon catalog size")
	local nodeDungeon = DungeonCatalog.get("Dungeon_Threshold_NodeUndercroft")
	Harness.assert(nodeDungeon ~= nil and nodeDungeon.TimeLimit == 900, "dungeon time limit")
	local pulse = AbilityCatalog.get("Pulse")
	Harness.assert(pulse ~= nil, "pulse for presentation profiles")
	if pulse ~= nil then
		Harness.assertEqual(pulse.AnimationProfile.Id, "Combat", "pulse AnimationProfile Id")
		Harness.assertEqual(pulse.CameraProfile.Id, "Combat", "pulse CameraProfile Id")
		Harness.assertEqual(pulse.VFXProfile.Id, "Energy", "pulse VFXProfile Id equals school")
		Harness.assertEqual(pulse.SFXProfile.Id, "Energy", "pulse SFXProfile Id equals school")
	end
	local storm = AbilityCatalog.get("AstralStorm")
	Harness.assert(storm ~= nil and storm.TargetType == "Ground", "storm is ground")
	Harness.assert(MacroCatalog.get("GroundStorm") ~= nil, "ground storm macro")
	Harness.assert(MacroCatalog.get("PulsePriority") ~= nil, "pulse priority macro")
	Harness.assert(IconCatalog.ability("Pulse", "Weaver").glyph ~= "", "ability icon glyph")
	Harness.assert(IconCatalog.item("KynShard", "Epic", "Weaver").glyph ~= "", "item icon glyph")
	local iconCounts = IconCatalog.counts()
	Harness.assertEqual(iconCounts.abilities, AbilityCatalog.count(), "ability icon atlas coverage")
	Harness.assertEqual(iconCounts.items, #ItemCatalog.all(), "item icon atlas coverage")
	Harness.assert(iconCounts.slots >= 20, "equipment slot icon atlas")
	Harness.assert(ArchetypeTalentCatalog.get("Warden_Aegis_T1") ~= nil, "warden tree talent")
	Harness.assert(ArchetypeTalentCatalog.count() >= 12 * 21, "archetype talent count")
	local wardenTrees = TalentTreeCatalog.forArchetype("Warden")
	Harness.assertEqual(#wardenTrees, 3, "three talent trees per class")
	Harness.assertEqual(#wardenTrees[1].Nodes, 7, "seven tiers per tree")
	Harness.assert(ArchetypeCatalog.get("Warden") ~= nil, "warden archetype")
	local archFloor = 0
	for _ in ArchetypeCatalog.all() do
		archFloor += 1
	end
	Harness.assertEqual(archFloor, 12, "twelve archetypes")
	Harness.assert(ZoneCatalog.defaultId() == "Zone_Threshold", "default zone")
	Harness.assert(ZoneCatalog.count() >= 9, "kynfall zone count")
	Harness.assert(ZoneCatalog.get("Zone_Void") ~= nil, "voidmarch exists")
	Harness.assert(ZoneCatalog.get("Zone_Tide") ~= nil, "tidehaven exists")
	Harness.assert(ZoneCatalog.get("Zone_Thorn") ~= nil, "thornwood exists")
	Harness.assert(ZoneCatalog.get("Zone_Sky") ~= nil, "skyreach exists")

	Harness.assert(RewardResolver.xpForLevel(1) > 0, "xp curve")
end

return CatalogsSpec
