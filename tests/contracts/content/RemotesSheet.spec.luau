--!strict

-- Achievement, cosmetic, remote, and loot catalogs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AbilityCatalog = require(ReplicatedStorage.Definitions.Abilities.AbilityCatalog)
local AchievementCatalog = require(ReplicatedStorage.Definitions.Characters.AchievementCatalog)
local AffixCatalog = require(ReplicatedStorage.Definitions.Items.AffixCatalog)
local BossCatalog = require(ReplicatedStorage.Definitions.Encounters.BossCatalog)
local CollectionCatalog = require(ReplicatedStorage.Definitions.Items.CollectionCatalog)
local CosmeticCatalog = require(ReplicatedStorage.Definitions.Characters.CosmeticCatalog)
local CraftingCatalog = require(ReplicatedStorage.Definitions.Items.CraftingCatalog)
local DailyQuestCatalog = require(ReplicatedStorage.Definitions.World.DailyQuestCatalog)
local EnchantCatalog = require(ReplicatedStorage.Definitions.Items.EnchantCatalog)
local GemCatalog = require(ReplicatedStorage.Definitions.Items.GemCatalog)
local HarnessApi = require(script.Parent.Parent.Parent.HarnessApi)
local ItemCatalog = require(ReplicatedStorage.Definitions.Items.ItemCatalog)
local MachineCatalog = require(ReplicatedStorage.Definitions.World.MachineCatalog)
local PerformanceBudgets = require(ReplicatedStorage.Shared.Constants.PerformanceBudgets)
local ProfessionCatalog = require(ReplicatedStorage.Definitions.Items.ProfessionCatalog)
local RaidCatalog = require(ReplicatedStorage.Definitions.Encounters.RaidCatalog)
local RemoteCatalog = require(ReplicatedStorage.Shared.Protocols.RemoteCatalog)
local SetBonusCatalog = require(ReplicatedStorage.Definitions.Items.SetBonusCatalog)
local VendorCatalog = require(ReplicatedStorage.Definitions.Items.VendorCatalog)

type Harness = HarnessApi.Harness

local RemotesSheetSpec = {}

function RemotesSheetSpec.run(Harness: Harness)
	Harness.assert(AchievementCatalog.get("Achievement_Created") ~= nil, "created feat")
	Harness.assert(AchievementCatalog.get("Achievement_VoidHollow") ~= nil, "rift walker feat")
	Harness.assert(AchievementCatalog.get("Achievement_Endgame") ~= nil, "endgame feat")
	Harness.assert(AchievementCatalog.get("Achievement_Friends") ~= nil, "friends feat")
	Harness.assert(AchievementCatalog.count() >= 16, "achievement catalog")
	Harness.assert(CosmeticCatalog.get("Cosmetic_Title_Pulseborn") ~= nil, "pulseborn title")
	Harness.assert(CosmeticCatalog.forAchievement("Achievement_VoidHollow") ~= nil, "rift title")
	Harness.assert(CosmeticCatalog.count() >= 16, "title catalog")
	Harness.assert(RemoteCatalog.get("StartDungeon") ~= nil, "dungeon remote catalogued")
	Harness.assert(RemoteCatalog.get("StartRaid") ~= nil, "raid remote catalogued")
	Harness.assert(RemoteCatalog.get("TargetUnit") ~= nil, "target remote catalogued")
	Harness.assert(RemoteCatalog.get("QueueWarfield") ~= nil, "battleground remote catalogued")
	Harness.assert(RemoteCatalog.get("StopCast") ~= nil, "stop cast remote catalogued")
	Harness.assert(RemoteCatalog.get("MoveItem") ~= nil, "move item remote catalogued")
	Harness.assert(RemoteCatalog.get("UseItem") ~= nil, "use item remote catalogued")
	Harness.assert(RemoteCatalog.get("SellVendorItem") ~= nil, "sell remote catalogued")
	Harness.assert(RemoteCatalog.get("SettlementClaim") ~= nil, "settlement claim remote")
	local frameRecipe = CraftingCatalog.get("MachineFrame")
	Harness.assert(frameRecipe ~= nil and frameRecipe.ProfessionId == "Smithing", "machine frame smithing")
	Harness.assert(ProfessionCatalog.get("Mining") ~= nil, "mining profession")
	Harness.assert(MachineCatalog.get("IngotPress") ~= nil, "ingot press machine")
	local mend = AbilityCatalog.get("Mend")
	local mendScaling = if mend then mend.Scaling else nil
	Harness.assert(mendScaling ~= nil and mendScaling.AbilityPower == 0, "mend heal scaling")
	local guardian = BossCatalog.get("Boss_Threshold_Guardian")
	local guardianTags = if guardian then guardian.Tags else nil
	Harness.assert(guardianTags ~= nil and #guardianTags >= 2, "boss tags")
	Harness.assert(RemoteCatalog.get("DropItem") ~= nil, "drop remote catalogued")
	Harness.assert(RemoteCatalog.get("Respawn") ~= nil, "respawn remote catalogued")
	Harness.assert(RemoteCatalog.get("LearnMastery") ~= nil, "learn mastery remote catalogued")
	Harness.assert(RemoteCatalog.get("AuctionCancel") ~= nil, "auction cancel remote catalogued")
	Harness.assert(RemoteCatalog.get("PartyDecline") ~= nil, "party decline remote catalogued")
	Harness.assert(RemoteCatalog.get("TradeDecline") ~= nil, "trade decline remote catalogued")
	Harness.assert(RemoteCatalog.get("GuildLeave") ~= nil, "guild leave remote catalogued")
	Harness.assert(RemoteCatalog.get("SetSetting") ~= nil, "settings remote catalogued")
	Harness.assert(RemoteCatalog.get("PartyKick") ~= nil, "party kick catalogued")
	Harness.assert(RemoteCatalog.get("PartyPromote") ~= nil, "party promote catalogued")
	Harness.assert(RemoteCatalog.get("GuildInvite") ~= nil, "guild invite catalogued")
	Harness.assert(RemoteCatalog.get("GuildAccept") ~= nil, "guild accept catalogued")
	Harness.assert(RemoteCatalog.get("GuildWithdraw") ~= nil, "guild withdraw catalogued")
	Harness.assert(RemoteCatalog.get("FriendAdd") ~= nil, "friend add catalogued")
	Harness.assert(RemoteCatalog.get("BlockPlayer") ~= nil, "block catalogued")
	Harness.assert(RemoteCatalog.get("WhisperChannelRequest") ~= nil, "whisper channel request catalogued")
	Harness.assert(RemoteCatalog.get("DeleteMail") ~= nil, "delete mail catalogued")
	Harness.assert(RemoteCatalog.get("LeaveQueue") ~= nil, "leave queue catalogued")
	Harness.assert(RemoteCatalog.get("InspectPlayer") ~= nil, "inspect catalogued")
	Harness.assert(RemoteCatalog.get("InspectResult") ~= nil, "inspect result catalogued")
	Harness.assert(RemoteCatalog.get("StopMacro") ~= nil, "stop macro remote catalogued")
	Harness.assert(RemoteCatalog.get("SaveMacro") ~= nil, "save macro remote catalogued")
	Harness.assert(RemoteCatalog.get("BindActionBar") ~= nil, "bind bar remote catalogued")
	local sheet = RemoteCatalog.get("CharacterSheet")
	Harness.assert(sheet ~= nil, "character sheet catalogued")
	if sheet then
		local keys: { [string]: boolean } = {}
		for _, key in sheet.PayloadKeys do
			keys[key] = true
		end
		Harness.assert(keys.pvpLosses == true, "sheet pvp losses")
		Harness.assert(keys.barProfile == true, "sheet bar profile")
		Harness.assert(keys.transformationId == true, "sheet transformation")
		Harness.assert(keys.combatLog == true, "sheet combat log")
		Harness.assert(keys.camera == true, "sheet camera")
		Harness.assert(keys.guildRank == true, "sheet guild rank")
		Harness.assert(keys.bagCap == true, "sheet bag cap")
		Harness.assert(keys.dailySpent == true, "sheet daily spent")
		Harness.assert(keys.queuedPvp == true, "sheet queued pvp")
		Harness.assert(keys.honor == true, "sheet honor")
		Harness.assert(keys.restXp == true, "sheet rest xp")
		Harness.assert(keys.pendingLoot == true, "sheet pending loot")
		Harness.assert(keys.lockouts == true, "sheet lockouts")
		Harness.assert(keys.collections == true, "sheet collections")
		Harness.assert(keys.auras == true, "sheet auras")
		Harness.assert(keys.characterName == true, "sheet character name")
		Harness.assert(keys.targetName == true, "sheet target name")
		Harness.assert(keys.totName == true, "sheet target of target")
		Harness.assert(keys.uiScale == true, "sheet ui scale")
		Harness.assert(keys.uiTheme == true, "sheet ui theme")
		Harness.assert(keys.reduceMotion == true, "sheet reduce motion")
		Harness.assert(keys.targetHp == true, "sheet target hp")
		Harness.assert(keys.targetKind == true, "sheet target kind")
		Harness.assert(keys.liveOps == true, "sheet liveOps")
		Harness.assert(keys.build == true, "sheet build aggregate")
		Harness.assert(keys.loadouts == true, "sheet loadouts list")
		Harness.assert(keys.activeLoadoutId == true, "sheet active loadout")
		Harness.assert(keys.guildStructures == true, "sheet guild structures")
		Harness.assert(keys.eventObjective == true, "sheet event objective")
		Harness.assert(keys.settlementId == true, "sheet settlement")
	end
	Harness.assert(RemoteCatalog.get("RepairAll") ~= nil, "repair all catalogued")
	Harness.assert(RemoteCatalog.get("UpgradeItem") ~= nil, "upgrade catalogued")
	Harness.assert(RemoteCatalog.get("SocketGem") ~= nil, "socket catalogued")
	Harness.assert(RemoteCatalog.get("EnchantItem") ~= nil, "enchant catalogued")
	Harness.assert(RemoteCatalog.get("LootRoll") ~= nil, "loot roll catalogued")
	Harness.assert(RemoteCatalog.get("GatherNode") ~= nil, "gather catalogued")
	Harness.assert(RemoteCatalog.get("UseGateBind") ~= nil, "gate bind catalogued")
	Harness.assert(RemoteCatalog.get("BuybackItem") ~= nil, "buyback catalogued")
	Harness.assert(RemoteCatalog.get("DuelChallenge") ~= nil, "duel catalogued")
	Harness.assert(RemoteCatalog.get("ReadyCheck") ~= nil, "ready check catalogued")
	Harness.assert(SetBonusCatalog.get("Astral") ~= nil, "astral set bonus")
	Harness.assert(RaidCatalog.get("Raid_Threshold_Spire") ~= nil, "raid catalog")
	Harness.assert(RaidCatalog.count() >= 1, "raid catalog size")
	local raid = RaidCatalog.get("Raid_Threshold_Spire")
	Harness.assert(raid ~= nil and #raid.BossIds >= 2, "raid sequential bosses")
	Harness.assert(PerformanceBudgets.MaxSimultaneousVfx >= 8, "vfx budget")
	Harness.assert(AffixCatalog.count() >= 6, "affix catalog")
	Harness.assert(GemCatalog.get("CritGem") ~= nil, "crit gem")
	Harness.assert(EnchantCatalog.get("EnchantHaste") ~= nil, "haste enchant")
	Harness.assert(CollectionCatalog.get("Collection_AstralCrown") ~= nil, "astral collection")
	Harness.assert(DailyQuestCatalog.get("DailyQuest_Threshold_OreTithe") ~= nil, "gather daily")
	Harness.assert(DailyQuestCatalog.count() >= 8, "daily catalog")
	Harness.assert(ItemCatalog.get("HonorSignet") ~= nil, "honor signet")
	Harness.assert(ItemCatalog.get("CritGem") ~= nil, "crit gem item")
	Harness.assert(ItemCatalog.get("HealthTonic") ~= nil, "food item")
	local honorOffer = VendorCatalog.get("HonorSignet")
	Harness.assert(honorOffer ~= nil and honorOffer.Honor == 40, "honor vendor")
	local gemRecipe = CraftingCatalog.get("CritGem")
	Harness.assert(gemRecipe ~= nil and gemRecipe.RequiredSkill >= 15, "gem skill gate")
end

return RemotesSheetSpec
