local ReplicatedStorage = game:GetService("ReplicatedStorage")
local NetworkConstants = require(ReplicatedStorage.Shared.Constants.NetworkConstants)
local RemoteTypes = require(ReplicatedStorage.Shared.Types.RemoteTypes)

type RemoteDefinition = RemoteTypes.RemoteDefinition

local FORBIDDEN_AUTHORITY = { "damage", "currency", "cooldown", "inventory", "reward", "xp", "gold", "health" }

local function remote(
	id: string,
	folder: string,
	direction: RemoteTypes.RemoteDirection,
	rate: number,
	keys: { string },
	permissions: string?,
	deferred: boolean?
): RemoteDefinition
	return {
		Id = id,
		Folder = folder,
		Direction = direction,
		RateLimitPerSecond = rate,
		Permissions = permissions or "Player",
		Logging = true,
		ErrorPolicy = "Reject",
		PayloadKeys = keys,
		ForbiddenKeys = FORBIDDEN_AUTHORITY,
		Deferred = deferred == true,
	}
end

