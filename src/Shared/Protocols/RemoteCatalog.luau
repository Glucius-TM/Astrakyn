local byId: { [string]: RemoteDefinition } = {}
for _, entry in catalog do
	byId[entry.Id] = entry
end

local RemoteCatalog = {}

function RemoteCatalog.all(): { RemoteDefinition }
	return catalog
end

function RemoteCatalog.get(id: string): RemoteDefinition?
	return byId[id]
end

return RemoteCatalog
