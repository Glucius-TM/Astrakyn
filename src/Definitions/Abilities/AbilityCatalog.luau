type AbilityDefinition = AbilityTypes.AbilityDefinition
type AbilityScaling = AbilityTypes.AbilityScaling

local DEFAULT_SCALING: AbilityScaling = {
	AbilityPower = 1,
	AttackPower = 0.15,
	HealingPower = 1,
	WeaponDamage = 0,
}

local HEAL_SCALING: AbilityScaling = {
	AbilityPower = 0,
	AttackPower = 0,
	HealingPower = 1,
	WeaponDamage = 0,
}

local PHYSICAL_SCALING: AbilityScaling = {
	AbilityPower = 0.4,
	AttackPower = 0.35,
	HealingPower = 0,
	WeaponDamage = 0.55,
}

local ENERGY_SCALING: AbilityScaling = {
	AbilityPower = 1.15,
	AttackPower = 0,
	HealingPower = 0,
	WeaponDamage = 0,
}

local function a(
	id: string,
	name: string,
	kind: AbilityTypes.AbilityType,
	school: AbilityTypes.AbilitySchool,
	cast: AbilityTypes.CastType,
	target: AbilityTypes.TargetType,
	cooldown: number,
	cost: number,
	effects: { string },
	range: number,
	scaling: AbilityScaling?,
	costResource: string?,
	weaponChannel: AbilityTypes.WeaponChannel?,
	requirements: { string }?
): AbilityDefinition
	local resource = costResource or "Energy"
	return {
		Id = id,
		Name = name,
		Type = kind,
		School = school,
		CastType = cast,
		TargetType = target,
		Range = range,
		Radius = if target == "Ground" then 8 else 0,
		CastTime = if cast == "Cast" then 1.4 else 0,
		ChannelDuration = if cast == "Channel" then 3 else nil,
		ChannelTickInterval = if cast == "Channel" then 1 else nil,
		Cooldown = cooldown,
		GlobalCooldown = 1,
		Charges = 1,
		ResourceCost = if cost > 0 then { Resource = resource, Amount = cost } else nil,
		Requirements = requirements or {},
		Conditions = {},
		Effects = effects,
		Tags = { "Playable" },
		Scaling = scaling or DEFAULT_SCALING,
		WeaponChannel = weaponChannel,
		AnimationProfile = { Id = "Combat" },
		VFXProfile = { Id = school },
		SFXProfile = { Id = school },
		CameraProfile = { Id = "Combat" },
		ComboRules = {},
	}
end

