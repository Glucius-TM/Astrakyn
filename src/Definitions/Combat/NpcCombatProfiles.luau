--!strict

export type Profile = {
	Id: string,
	Reach: number,
	AggroRadius: number,
	AssistRadius: number,
	SwingPeriod: number,
	LeashRadius: number,
	EvadeResetSeconds: number,
	CanChase: boolean,
	ChaseSpeed: number,
	RepathSeconds: number,
	AgentRadius: number,
	AgentHeight: number,
	AttackPower: number,
	AbilityPower: number,
	CritChance: number,
}

type ProfileSeed = {
	Reach: number,
	AggroRadius: number,
	AssistRadius: number,
	SwingPeriod: number,
	LeashRadius: number,
	EvadeResetSeconds: number,
	CanChase: boolean,
	ChaseSpeed: number,
	RepathSeconds: number,
	AgentRadius: number,
	AgentHeight: number,
	AttackPower: number,
	AbilityPower: number,
	CritChance: number,
}

local function profile(id: string, row: ProfileSeed): Profile
	return {
		Id = id,
		Reach = row.Reach,
		AggroRadius = row.AggroRadius,
		AssistRadius = row.AssistRadius,
		SwingPeriod = row.SwingPeriod,
		LeashRadius = row.LeashRadius,
		EvadeResetSeconds = row.EvadeResetSeconds,
		CanChase = row.CanChase,
		ChaseSpeed = row.ChaseSpeed,
		RepathSeconds = row.RepathSeconds,
		AgentRadius = row.AgentRadius,
		AgentHeight = row.AgentHeight,
		AttackPower = row.AttackPower,
		AbilityPower = row.AbilityPower,
		CritChance = row.CritChance,
	}
end

