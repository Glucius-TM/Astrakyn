local NpcCombatProfiles = {}

function NpcCombatProfiles.get(id: string): Profile
	return profiles[id] or profiles.Enemy
end

function NpcCombatProfiles.has(id: string): boolean
	return profiles[id] ~= nil
end

function NpcCombatProfiles.all(): { [string]: Profile }
	return profiles
end

return NpcCombatProfiles
