local byId: { [string]: QuestDefinition } = {}
for _, q in quests do
	byId[q.Id] = q
end

local QuestCatalog = {}

function QuestCatalog.get(id: string): QuestDefinition?
	return byId[id]
end

function QuestCatalog.count(): number
	return #quests
end

function QuestCatalog.forZone(zoneId: string): { QuestDefinition }
	local list: { QuestDefinition } = {}
	for _, quest in quests do
		if quest.ZoneId == zoneId then
			table.insert(list, quest)
		end
	end
	return list
end

return QuestCatalog
