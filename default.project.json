{
  "name": "ASTRAKYN",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/Shared"
      },
      "Definitions": {
        "$path": "src/Definitions"
      },
      "ArtManifests": {
        "$className": "Folder",
        "IconAtlasAssets": {
          "$path": "assets/manifests/atlas_assets.json"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "ModelStreamingBehavior": "Improved",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 1024,
        "StreamOutBehavior": "Opportunistic"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "RuntimeConfig": {
        "$path": "config/runtime.json"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Bootstrap": {
        "$path": "src/Server/Bootstrap"
      },
      "Platform": {
        "$path": "src/Server/Platform"
      },
      "Domains": {
        "$path": "src/Server/Domains"
      },
      "AI": {
        "$path": "src/Server/AI"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/Client"
        }
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "CreateDefaultTextChannels": false,
        "CreateDefaultCommands": false
      }
    }
  }
}
